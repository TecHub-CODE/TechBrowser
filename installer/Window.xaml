<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" BorderBrush="#343B45" BorderThickness="1" CornerRadius="18" Background="#0D1014" ClipToBounds="True">
 <Border.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F4F6F8"/><Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/><Setter Property="TextOptions.TextFormattingMode" Value="Display"/></Style>
  <Style x:Key="ChromeButton" TargetType="Button"><Setter Property="Width" Value="42"/><Setter Property="Height" Value="36"/><Setter Property="Foreground" Value="#AEB6C2"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="surface" Background="{TemplateBinding Background}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Background" Value="#20252C"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="LinkButton" TargetType="Button"><Setter Property="Foreground" Value="#C7CED8"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0,6"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/><Setter Property="FontSize" Value="12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#FFFFFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="SecondaryButton" TargetType="Button"><Setter Property="MinWidth" Value="96"/><Setter Property="Height" Value="42"/><Setter Property="Foreground" Value="#D7DCE3"/><Setter Property="Background" Value="#151A20"/><Setter Property="BorderBrush" Value="#343C47"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="20,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/><Setter Property="FontSize" Value="13"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Background" Value="#1E242C"/><Setter TargetName="surface" Property="BorderBrush" Value="#4A5563"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="MinWidth" Value="110"/><Setter Property="Height" Value="42"/><Setter Property="Foreground" Value="#101318"/><Setter Property="Background" Value="#F0F3F6"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="22,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="13"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="surface" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Background" Value="#FFFFFF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.34"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="DataCheckBox" TargetType="CheckBox"><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="box" Width="17" Height="17" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0" Background="#11151A" BorderBrush="#4A5461" BorderThickness="1" CornerRadius="4"><Path x:Name="mark" Data="M 3 8 L 7 12 L 14 4" Stroke="#101318" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/></Border><ContentPresenter Grid.Column="1" Margin="10,0,0,0"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="#8E99A8"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="box" Property="Background" Value="#F0F3F6"/><Setter TargetName="box" Property="BorderBrush" Value="#F0F3F6"/><Setter TargetName="mark" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Border.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Background="#0F1217" BorderBrush="#292F38" BorderThickness="0,0,0,1">
   <Grid Margin="24,0,14,0">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image x:Name="HeaderLogo" Width="25" Height="25" Stretch="Uniform"/><TextBlock Text="TechBrowser" Margin="11,0,0,0" VerticalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="15" FontWeight="SemiBold"/></StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="Minimize" Style="{StaticResource ChromeButton}" Content="─" FontSize="15"/><Button x:Name="Close" Style="{StaticResource ChromeButton}" Content="✕" FontSize="14"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="39*"/><ColumnDefinition Width="61*"/></Grid.ColumnDefinitions>
   <Border ClipToBounds="True" BorderBrush="#292F38" BorderThickness="0,0,1,0">
    <Grid>
     <Image x:Name="Art" Stretch="UniformToFill"/>
     <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#19080A0D" Offset="0"/><GradientStop Color="#78080A0D" Offset="1"/></LinearGradientBrush></Border.Background></Border>
     <Image x:Name="BrowserLogo" Width="132" Height="132" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,96,0,0"/>
     <StackPanel VerticalAlignment="Bottom" Margin="34,0,28,32">
      <TextBlock x:Name="Motto" Text="Kendi alanınız. Kendi tarayıcınız." FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="20" FontWeight="SemiBold" LineHeight="27" TextWrapping="Wrap"/>
      <StackPanel Orientation="Horizontal" Margin="0,22,0,0"><Image x:Name="StudioLogo" Width="27" Height="27" Stretch="Uniform"/><StackPanel Margin="11,-1,0,0"><TextBlock Text="TechHub Studio" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="Designed in Türkiye" FontSize="10" Foreground="#8993A1" Margin="0,2,0,0"/></StackPanel></StackPanel>
     </StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Column="1" Margin="52,46,48,34">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="Heading" Text="Başlamaya hazırsınız." FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="34" FontWeight="SemiBold" LineHeight="41" TextWrapping="Wrap"/>
    <TextBlock x:Name="Subtitle" Grid.Row="1" Text="TechHub ailesine hoş geldiniz. Kurulum yalnızca birkaç saniye sürecek." FontSize="15" Foreground="#A9B2BE" LineHeight="22" TextWrapping="Wrap" Margin="0,12,0,0"/>
    <Border x:Name="InstallCard" Grid.Row="2" VerticalAlignment="Center" Background="#12161B" BorderBrush="#2B323C" BorderThickness="1" CornerRadius="13" Padding="24,22" Margin="0,28,0,24">
     <StackPanel>
      <Grid><TextBlock x:Name="Status" Text="Kuruluma hazır" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="Percent" HorizontalAlignment="Right" FontSize="13" Foreground="#D8DEE7"/></Grid>
      <ProgressBar x:Name="Progress" Height="5" Margin="0,15,0,11" Foreground="#E4E8ED" Background="#2A3038" BorderThickness="0" Maximum="100"/>
      <TextBlock x:Name="Hint" Text="Başlamak için Kur'u seçin." FontSize="11" Foreground="#8993A1" TextWrapping="Wrap"/>
      <Border Height="1" Background="#282E37" Margin="0,21,0,18"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock x:Name="Step1" Text="01  Hazırlık" FontSize="11" Foreground="#B9C1CC"/><TextBlock x:Name="Step2" Grid.Column="1" Text="02  Kurulum" HorizontalAlignment="Center" FontSize="11" Foreground="#737E8D"/><TextBlock x:Name="Step3" Grid.Column="2" Text="03  Tamamlandı" HorizontalAlignment="Right" FontSize="11" Foreground="#737E8D"/></Grid>
     </StackPanel>
    </Border>
    <StackPanel x:Name="PerformanceStep" Grid.Row="2" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,28,0,24">
     <Border Height="1" Background="#2B323C" Margin="0,0,0,23"/>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#171C22" BorderBrush="#343C47" BorderThickness="1" CornerRadius="8">
       <Path Data="M 6 15 L 10 11 L 13 14 L 20 7 M 16 7 L 20 7 L 20 11" Stroke="#E7EBF0" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
      </Border>
      <StackPanel Grid.Column="1">
       <TextBlock Text="Cihazınıza göre önerildi" FontSize="13" FontWeight="SemiBold"/>
       <TextBlock x:Name="DetectedMemory" Text="Cihazınızda RAM bilgisi tespit edildi." FontSize="12" Foreground="#9EA8B5" Margin="0,7,0,0"/>
       <TextBlock Text="TechBrowser'ın donanımınızda daha akıcı çalışabilmesi için arka plan sekmeleri ve görsel efektler daha az kaynak kullanır." FontSize="12" Foreground="#7F8A98" LineHeight="18" TextWrapping="Wrap" Margin="0,13,0,0"/>
      </StackPanel>
     </Grid>
     <Border Height="1" Background="#2B323C" Margin="0,23,0,0"/>
    </StackPanel>
    <StackPanel x:Name="Options" Grid.Row="3"><TextBlock x:Name="InstallPath" FontSize="10" Foreground="#768190" TextTrimming="CharacterEllipsis"/><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><Button x:Name="Location" Style="{StaticResource LinkButton}" Content="Kurulum konumu"/><Border Width="1" Height="12" Background="#353C46" Margin="14,0" VerticalAlignment="Center"/><Button x:Name="License" Style="{StaticResource LinkButton}" Content="Lisans koşulları"/></StackPanel></StackPanel>
    <Border x:Name="DeleteDataOption" Grid.Row="3" Visibility="Collapsed" Background="#12161B" BorderBrush="#303741" BorderThickness="1" CornerRadius="11" Padding="15,13">
     <CheckBox x:Name="DeleteData" Style="{StaticResource DataCheckBox}"><StackPanel><TextBlock Text="Kişisel verilerimi de bu cihazdan sil" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="Geçmiş, çerezler, oturumlar, kayıtlı şifreler ve yerel ayarlar kalıcı olarak silinir. Bulut hesabınız etkilenmez." FontSize="10" Foreground="#8D97A5" LineHeight="15" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></CheckBox>
    </Border>
    <Grid Grid.Row="4" Margin="0,24,0,0"><TextBlock x:Name="FooterNote" Text="Güvenli kurulum" FontSize="10" Foreground="#687381" VerticalAlignment="Center"/><StackPanel x:Name="DefaultActions" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Cancel" Style="{StaticResource SecondaryButton}" Content="İptal" Margin="0,0,10,0"/><Button x:Name="Action" Style="{StaticResource PrimaryButton}" Content="Kur"/></StackPanel><StackPanel x:Name="PerformanceActions" Visibility="Collapsed" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="StandardMode" Style="{StaticResource LinkButton}" Content="Standart modla devam et" Padding="10,10" Margin="0,0,14,0"/><Button x:Name="EnablePerformance" Style="{StaticResource PrimaryButton}" Content="Performans Kipiyle devam et"/></StackPanel></Grid>
   </Grid>
  </Grid>
 </Grid>
</Border>
